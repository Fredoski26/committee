# Database URL (SQLite or Neon PostgreSQL)
# For local SQLite:
# DATABASE_URL="file:./dev.db"
# For Neon PostgreSQL (required in production on Vercel):
# DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# Webhook Secret for Google Apps Script to authenticate
# Set this exact value in Google Apps Script -> Project Settings -> Script Properties -> WEBHOOK_SECRET
GOOGLE_FORMS_WEBHOOK_SECRET="your_webhook_secret_here"

# Admin API Key for securing admin endpoints
ADMIN_API_KEY="your_admin_secret_key"

# Next.js Port and Base URL
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
